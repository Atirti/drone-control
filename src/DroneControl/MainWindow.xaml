<Window
    x:Class="DroneControl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DroneControl.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Du-HD4K • Управление"
    Width="1160" Height="800" MinWidth="900" MinHeight="720"
    Style="{StaticResource MaterialDesignWindow}"
    Background="{DynamicResource MaterialDesign.Brush.Background}"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    TextElement.FontSize="14" UseLayoutRounding="True"
    Deactivated="FocusLost" Closing="WindowClosing">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Подключение и снимок. -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Du-HD4K" FontSize="28" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" Margin="0,4,0,0"
                           Style="{StaticResource CaptionStyle}" Text="Не подключён" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButtonStyle}" Click="SaveSnapshot">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Camera" Style="{StaticResource ButtonIconStyle}" />
                        <TextBlock Text="Снимок" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ConnectButton" MinWidth="150"
                        Style="{StaticResource ActionButtonStyle}"
                        Content="Подключить" Click="ConnectionClicked" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <materialDesign:Card UniformCornerRadius="12" Background="#10151E">
                    <Grid>
                        <Image x:Name="VideoImage" Stretch="Uniform" />
                        <StackPanel x:Name="VideoHint" Margin="20"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="VideoOutline" Width="48" Height="48"
                                                     HorizontalAlignment="Center" Foreground="#CDD5E3" />
                            <TextBlock Margin="0,16,0,0" FontSize="18" Foreground="#CDD5E3"
                                       Text="Камера дрона" TextAlignment="Center" />
                            <TextBlock Margin="0,8,0,0" Foreground="#A8B7CD" TextAlignment="Center"
                                       Text="Подключитесь к Wi-Fi дрона&#10;и нажмите «Подключить»" />
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Два независимых стика: мышь или два пальца на сенсорном экране. -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Высота и поворот" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        <controls:Joystick x:Name="LeftStick" IsEnabled="False"
                                           ToolTip="Вверх/вниз — газ; влево/вправо — поворот"
                                           AutomationProperties.Name="Левый стик: высота и поворот" />
                        <TextBlock Text="↑ Выше · ↓ Ниже · ↔ Поворот"
                                   Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="Движение" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        <controls:Joystick x:Name="RightStick" IsEnabled="False"
                                           ToolTip="Вперёд/назад и влево/вправо; можно по диагонали"
                                           AutomationProperties.Name="Правый стик: движение" />
                        <TextBlock Text="↑ Вперёд · ↓ Назад · ↔ В стороны"
                                   Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Остановка остаётся вне прокрутки. -->
            <materialDesign:Card Grid.Column="2" Padding="12" UniformCornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Управление" FontSize="20" FontWeight="SemiBold" Margin="4,4,4,16" />
                            <TextBlock Margin="4,0,4,16"
                                       Text="Перетаскивайте стики мышью или пальцами."
                                       Style="{StaticResource CaptionStyle}" />
                            <CheckBox x:Name="Armed" Margin="4,4,4,20"
                                      Content="Включить управление" IsEnabled="False"
                                      Checked="ArmChanged" Unchecked="ArmChanged" />

                            <Grid Margin="4,0,4,4">
                                <TextBlock Text="Скорость" FontSize="16" />
                                <TextBlock HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                           Text="{Binding ElementName=Power, Path=Value, StringFormat={}{0:0}%}" />
                            </Grid>
                            <Slider x:Name="Power" Margin="4,0,4,16"
                                    Minimum="10" Maximum="100" Value="30" TickFrequency="5"
                                    IsSnapToTickEnabled="True" ToolTip="Максимальная интенсивность отклонения стиков" />
                            <TextBlock Margin="4,0,4,20" Style="{StaticResource CaptionStyle}"
                                       Text="Чем дальше стик от центра, тем сильнее команда. Отпустите — он вернётся в центр." />

                            <StackPanel x:Name="FlightControls" IsEnabled="False">
                                <Button Style="{StaticResource ActionButtonStyle}" Content="Взлёт" Tag="1" Click="ActionClicked" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Посадка" Tag="2" Click="ActionClicked" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Button x:Name="StopButton" Grid.Row="1" Margin="4,16,4,4"
                            Style="{StaticResource EmergencyButtonStyle}" Content="СТОП МОТОРОВ"
                            IsEnabled="False" Click="EmergencyClicked" />
                </Grid>
            </materialDesign:Card>
        </Grid>

        <TextBlock x:Name="NoticeText" Grid.Row="2" Margin="0,16,0,0"
                   Style="{StaticResource CaptionStyle}"
                   Text="Видео проверено на дроне. Полётное управление ещё не проверено." />
    </Grid>
</Window>
