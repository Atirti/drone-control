<Window
    x:Class="DroneControl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DroneControl.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="drun-control"
    Width="1160" Height="800" MinWidth="900" MinHeight="720"
    Style="{StaticResource MaterialDesignWindow}"
    Background="{DynamicResource MaterialDesign.Brush.Background}"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    TextElement.FontSize="14" UseLayoutRounding="True"
    Deactivated="FocusLost" Closing="WindowClosing">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card UniformCornerRadius="12" >
                <Grid>
                    <Image x:Name="VideoImage" Stretch="UniformToFill" />
                    <StackPanel x:Name="VideoHint" Margin="20"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="VideoOutline" Width="48" Height="48"
                                                 HorizontalAlignment="Center" Foreground="#CDD5E3" />
                        <TextBlock Margin="0,16,0,0" FontSize="18" Foreground="#CDD5E3"
                                   Text="Камера дрона" TextAlignment="Center" />
                        <TextBlock Margin="0,8,0,0" Foreground="#A8B7CD" TextAlignment="Center"
                                   Text="Подключитесь к Wi-Fi дрона&#10;и нажмите «Подключить»" />
                    </StackPanel>

                    <Grid VerticalAlignment="Bottom" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="Высота и поворот" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <controls:Joystick x:Name="LeftStick" IsEnabled="False"
                                               AutomationProperties.Name="Левый стик: высота и поворот" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="Движение" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <controls:Joystick x:Name="RightStick" IsEnabled="False"
                                               AutomationProperties.Name="Правый стик: движение" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </materialDesign:Card>

             <materialDesign:Card Grid.Column="2" Padding="12" UniformCornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Управление" FontSize="20" FontWeight="SemiBold" Margin="4,4,4,0" />
                        <TextBlock x:Name="StatusText" Margin="4,4,4,16"
                                   Style="{StaticResource CaptionStyle}" Text="Не подключён"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"/>

                        <Grid VerticalAlignment="Center"
                                    Margin="0, 0, 0, 16">
                            <Button x:Name="ConnectButton"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Content="Подключить" Click="ConnectionClicked" />
                        </Grid>

                        <ComboBox x:Name="InputSource" Margin="4,0,4,8" SelectedIndex="0"
                                  SelectionChanged="InputSourceChanged"
                                  AutomationProperties.Name="Источник управления">
                            <ComboBoxItem Content="Экранные стики" />
                            <ComboBoxItem Content="Геймпад" />
                        </ComboBox>
                        <TextBlock x:Name="InputStatusText" Margin="4,0,4,16"
                                   Text="Перетаскивайте стики мышью или пальцами."
                                   Style="{StaticResource CaptionStyle}" />

                        <CheckBox x:Name="Armed" Margin="4,4,4,20"
                                  Content="Включить управление" IsEnabled="False"
                                  Checked="ArmChanged" Unchecked="ArmChanged" />

                        <Grid Margin="4,0,4,4">
                            <TextBlock Text="Скорость" FontSize="16" />
                            <TextBlock HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                       Text="{Binding ElementName=Power, Path=Value, StringFormat={}{0:0}%}" />
                        </Grid>
                        <Slider x:Name="Power" Margin="4,0,4,16"
                                Minimum="30" Maximum="100" Value="30" Ticks="30,60,100"
                                IsSnapToTickEnabled="True"/>
                        <StackPanel x:Name="FlightControls" IsEnabled="False">
                            <Button Style="{StaticResource ActionButtonStyle}" Content="Взлёт " Tag="1" Click="ActionClicked" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Посадка" Tag="2" Click="ActionClicked" />
                            <Button x:Name="StopButton"
                                    Style="{StaticResource EmergencyButtonStyle}" Content="СТОП МОТОРОВ" IsEnabled="False"
                                    Click="EmergencyClicked" />
                        </StackPanel>
                        <TextBlock x:Name="NoticeText" Margin="0,4,0,0"
                                   Style="{StaticResource CaptionStyle}" Visibility="Hidden"/>
                        <StackPanel Margin="0, 10">
                            <TextBlock Text="Управление на геймпаде" FontWeight="Bold" FontSize="18"
                                       Margin="0, 0,0, 10"/>
                            <TextBlock Text="LB - Смена скорости"/>
                            <TextBlock Text="↑ - Взлет"/>
                            <TextBlock Text="↓ - Посадка"/>
                            <TextBlock Text="B - Стоп моторов"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>
