<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Headers\*.bin" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MaterialDesignThemes" Version="5.4.1-ci1521" />
        <PackageReference Include="SDL3-CS" Version="3.4.18" />
        <PackageReference Include="SDL3-CS.Windows" Version="3.4.18.1" />
    </ItemGroup>
</Project>
