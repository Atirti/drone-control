<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Общие размеры и отступы; шаблоны контролов предоставляет Material Design. -->
    <Style
        x:Key="ActionButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
    </Style>

    <Style
        x:Key="SecondaryButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
    </Style>

    <Style
        x:Key="EmergencyButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="Background" Value="#B3261E" />
        <Setter Property="BorderBrush" Value="#B3261E" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ButtonIconStyle" TargetType="materialDesign:PackIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
