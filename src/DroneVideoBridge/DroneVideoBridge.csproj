<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="../DroneControl/Protocol.cs" Link="Protocol.cs" />
        <Compile Include="../DroneControl/DroneLink.cs" Link="DroneLink.cs" />
        <Compile Include="../DroneControl/BlFrames.cs" Link="BlFrames.cs" />
        <EmbeddedResource Include="../DroneControl/Headers/*.bin">
            <LogicalName>DroneControl.Headers.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
</Project>
